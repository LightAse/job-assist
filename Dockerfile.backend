FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY pyproject.toml ./
COPY app ./app
COPY backend.py ./

RUN pip install --no-cache-dir .

EXPOSE 8000

CMD ["sh", "-c", "uvicorn backend:app --host ${BACKEND_HOST:-0.0.0.0} --port ${BACKEND_INTERNAL_PORT:-8000}"]
